{
  "codeRoot": "~/code",

  "tools": [
    {
      "name": "Git", "command": "git",
      "install": { "winget": "Git.Git", "brew": "git", "apt": "git", "dnf": "git" }
    },
    {
      "name": "GitHub CLI", "command": "gh",
      "install": { "winget": "GitHub.cli", "brew": "gh", "apt": "gh", "dnf": "gh" }
    },
    {
      "name": "Visual Studio Code", "command": "code",
      "install": { "winget": "Microsoft.VisualStudioCode", "brewCask": "visual-studio-code", "snap": "code --classic" }
    }
  ],

  "vscodeExtensions": [
    { "id": "anthropic.claude-code",             "name": "Claude Code",          "required": true },
    { "id": "github.vscode-pull-request-github", "name": "GitHub Pull Requests", "required": true },
    { "id": "github.vscode-github-actions",      "name": "GitHub Actions",       "required": false }
  ],

  "github": {
    "requiredScopes": ["repo", "workflow", "read:org"]
  },

  "skillRepos": [
    {
      "name": "ai-skills",
      "repo": "jdrodgers/ai-skills",
      "clonePath": "ai-skills",
      "mainWorktreePath": "ai-skills-main",
      "localMainGuard": false
    },
    {
      "name": "ai-skills-private",
      "repo": "jdrodgers/ai-skills-private",
      "clonePath": "ai-skills-private",
      "mainWorktreePath": "ai-skills-private-main",
      "localMainGuard": true
    }
  ],

  "claude": {
    "globalInstructions": { "repo": "ai-skills", "path": "claude/CLAUDE.md" },
    "sensitiveTermsFile": "~/.config/ai-skills/sensitive-terms.txt",
    "denyRules": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.config/ai-skills/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/config.local.json)",
      "Read(**/secrets.yaml)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)"
    ]
  }
}
